{% include "_head.j2" %}
<h1>{{ d.client.name }}: {{ d.engagement }}</h1>
<div class="sub">Prepared for {{ d.client.contact }} · {{ d.provider.signer }}, {{ d.provider.name }} · {{ d.date }} · Reference {{ d.id }}</div>
<div class="box"><div class="big">You get {{ d.result }}, in {{ d.timeframe }}.</div>
<p>{{ d.guarantee }} {{ d.no_guarantee }}</p></div>
<h2>Price and milestones</h2>
<table><tr><th>No.</th><th>What you receive</th><th>Due</th><th>Amount</th></tr>
{% for m in d.milestones %}<tr><td>{{ m.n }}</td><td><b>{{ m.title }}</b><ol>{% for i in m.steps %}<li>{{ i }}</li>{% endfor %}</ol></td><td>{{ m.due }}</td><td>${{ m.amount }}</td></tr>{% endfor %}
<tr><th colspan="3">Total, fixed price</th><th>${{ d.price }}</th></tr></table>
<p>{{ d.ownership }}</p>
<h2>What you do</h2><p>{{ d.stipulation }}</p>
<h2>Timeline</h2><table>{% for t in d.timeline %}<tr><td style="width:24%"><b>{{ t.day }}</b></td><td>{{ t.what }}</td></tr>{% endfor %}</table>
<h2>After {{ d.timeframe }}</h2><p>{{ d.after_minimums }}</p>
<h2>Questions</h2>{% for x in d.qa %}<p><b>{{ x.q }}</b> {{ x.a }}</p>{% endfor %}
<h2>Next step</h2><p>{{ d.next_step }}</p>
