// Deploy: npx wrangler deploy -c site-worker/wrangler.jsonc
// Cutover (after the eagleeye.sh zone is active): add
// "routes": [{ "pattern": "eagleeye.sh", "custom_domain": true }, { "pattern": "www.eagleeye.sh", "custom_domain": true }]
{
  "name": "eagleeye-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../site", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": true },
  "observability": { "enabled": true }
}
