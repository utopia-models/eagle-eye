# One pass of send/ledger_watch.py: new lines past the stored offsets -> POST /rest/events (forward-only, idempotent).
# Exit 1 = Eagle Eye unreachable; the offset stays and systemd retries in 60 s (bounded by StartLimit*).
[Unit]
Description=Eagle Eye facts fallback: deliver new ledger / hunt-send lines to /rest/events
StartLimitIntervalSec=1h
StartLimitBurst=30

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/architect/dev/utopia-models/eagle-eye-v2/send/ledger_watch.py
Restart=on-failure
RestartSec=60
TimeoutStartSec=120
