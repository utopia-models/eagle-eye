{
  "$description": "Eagle Eye site tokens (eagleeye.sh). Brand from eagle.utopiamodels.ai, live.utopiamodels.ai and utopiamodels.ai: ink, gold sand, Cinzel + Cormorant Garamond. styles.css :root mirrors these values one to one.",
  "color": {
    "ink":        { "$value": "#0a0a09", "$type": "color", "$description": "page ground" },
    "ink-raised": { "$value": "#11100d", "$type": "color", "$description": "code wells, the demo frame" },
    "gold":       { "$value": "#d9b35b", "$type": "color", "$description": "the brand gold: mark, primary button, rules" },
    "gold-bright":{ "$value": "#f3dc9a", "$type": "color", "$description": "light inside the sand, hover" },
    "gold-dim":   { "$value": "#8a7440", "$type": "color", "$description": "labels, hairlines" },
    "pearl":      { "$value": "#cfd8ff", "$type": "color", "$description": "iridescent sheen, only inside the light" },
    "text":       { "$value": "#ece4d0", "$type": "color", "$description": "body copy on ink" },
    "text-dim":   { "$value": "#a59d89", "$type": "color", "$description": "secondary copy on ink (contrast 7.4:1)" },
    "line":       { "$value": "rgba(217,179,91,0.22)", "$type": "color", "$description": "hairline rule" }
  },
  "font": {
    "display": { "$value": ["Cinzel", "Trajan Pro", "serif"], "$type": "fontFamily" },
    "serif":   { "$value": ["Cormorant Garamond", "Garamond", "serif"], "$type": "fontFamily" },
    "mono":    { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$type": "fontFamily" },
    "weight-display": { "$value": 500, "$type": "fontWeight" },
    "weight-serif":   { "$value": 400, "$type": "fontWeight" }
  },
  "size": {
    "h1":      { "$value": "clamp(2.2rem, 1.2rem + 3.6vw, 4rem)", "$type": "dimension" },
    "h2":      { "$value": "clamp(1.6rem, 1.1rem + 2vw, 2.8rem)", "$type": "dimension" },
    "lead":    { "$value": "clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem)", "$type": "dimension" },
    "body":    { "$value": "1.15rem", "$type": "dimension" },
    "label":   { "$value": "0.72rem", "$type": "dimension", "$description": "Cinzel small caps, letter-spacing 0.32em" },
    "code":    { "$value": "0.92rem", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "16px", "$type": "dimension" },
    "4": { "$value": "24px", "$type": "dimension" },
    "5": { "$value": "40px", "$type": "dimension" },
    "6": { "$value": "64px", "$type": "dimension" },
    "7": { "$value": "120px", "$type": "dimension" },
    "gutter": { "$value": "clamp(16px, 4vw, 48px)", "$type": "dimension" },
    "max":    { "$value": "1180px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension", "$description": "frames are sand lines with corner ticks, never rounded cards" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "buttons and the star pill" }
  },
  "shadow": {
    "glow": { "$value": { "color": "rgba(217,179,91,0.35)", "offsetX": "0px", "offsetY": "0px", "blur": "28px", "spread": "0px" }, "$type": "shadow" }
  },
  "motion": {
    "assemble": { "$value": "2400ms", "$type": "duration", "$description": "sand gathers into the Eye of Horus" },
    "reveal":   { "$value": "900ms",  "$type": "duration" },
    "hover":    { "$value": "200ms",  "$type": "duration" },
    "ease-out": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier" }
  }
}
