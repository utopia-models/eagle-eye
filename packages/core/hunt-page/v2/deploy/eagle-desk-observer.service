# Read-only watcher of the desk-upwork Chrome (CDP target discovery on 127.0.0.1:9402): a tab landing on Upwork's
# /nx/proposals/<id>?success page pushes proposal_sent to Eagle Eye. Never attaches to a page, never sends input.
[Unit]
Description=Eagle Eye desk observer: proposal submitted in desk-upwork Chrome -> proposal_sent fact
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/architect/dev/utopia-models/eagle-eye-v2/send/desk_observer.py
Restart=always
RestartSec=10
MemoryMax=80M

[Install]
WantedBy=default.target
