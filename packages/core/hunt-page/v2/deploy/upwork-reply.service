# Upwork 5-minute reply loop on Ra (systemd --user, architect), DRY-RUN. Install: cp deploy/upwork-reply.service ~/.config/systemd/user/ && systemctl --user enable --now upwork-reply
# Every 30 s: dev@'s Upwork "<Name> sent you a message" mail -> a reply row + "Reply, due in 5 min, owner upwork" on that
# client's roost. Dry-run: no fleetmail, no seat, drafts mail agent@ only. Live (power-on, poweron-queue.md): add --live.
[Unit]
Description=upwork-reply: Upwork client message -> answer in 5 min toward a call (dry-run)
After=network-online.target eagle-server.service

[Service]
WorkingDirectory=/home/architect/dev/utopia-models/eagle-eye-v2/send
ExecStart=/usr/bin/python3 /home/architect/dev/utopia-models/eagle-eye-v2/send/upwork_reply.py watch --every 30
Environment=PYTHONUNBUFFERED=1
MemoryMax=900M
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
